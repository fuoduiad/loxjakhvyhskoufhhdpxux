            <CheatEntry>
              <ID>183</ID>
              <Description>"房主取物(喷漆)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
alloc(pqg,100)
pqg:
sub rsp,28

mov rdi,libSandboxGame.dll+3E09C08
mov rdi,[rdi]


mov rax,[rdi]
mov r9d,#200
//数量
mov [rsp+20],rcx
mov r8d,#1001
//位置
mov edx,#4118
//id
mov rcx,rdi
call qword ptr [rax+00000318]
mov rbx,[rsp+40]


add rsp,28
ret


createthread(pqg)
[DISABLE]
dealloc(pqg,100)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1807689676</ID>
              <Description>"房主取物(仓库)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
alloc(qw,100)
qw:
sub rsp,28

mov rax,libSandboxGame.dll+3E09C08
mov rax,[rax]

mov r9d,#1
//1为快捷栏，2为背包，3为掉落物，3以上都是掉落物
mov r8d,#1000
//数量
mov edx,#1
//id
mov rcx,[rax]
mov r10,[rcx+00000148]

mov [rsp+20],cl
mov rcx,rax
call r10

add rsp,28
ret
 
createthread(qw)
[DISABLE]
dealloc(qw,100)
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
