        <CheatEntry>
          <ID>20640</ID>
          <Description>"紧凑模式"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$Lua}
function cycleFullCompact(sender,force)
local state = not(compactmenuitem.Caption == '默认')
if force~=nil then state = not force end
compactmenuitem.Caption = state and '默认' or '紧凑'
 getMainForm().Splitter1.Visible = state
 getMainForm().Panel4.Visible = state
 getMainForm().Panel5.Visible = state
 end
 function addCompactMenu()
 if compactmenualreadyexists then return end
  local parent = getMainForm().Menu.Items
  compactmenuitem = createMenuItem(parent)
  parent.add(compactmenuitem)
  compactmenuitem.Caption = '默认'
  compactmenuitem.OnClick = cycleFullCompact
   compactmenualreadyexists = 'yes'
   end
   addCompactMenu(); cycleFullCompact(nil,true)

[DISABLE]

luacall(cycleFullCompact(nil,false))
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1337336378</ID>
          <Description>"灵动岛"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end

-- 配置参数
local config = {
    x = 0,            -- 水平位置（0=自动居中）
    y = 30,           -- 垂直位置（距顶部距离）
    width = 410,      -- 窗体宽度
    height = 30,      -- 窗体高度
    bgColor = 0x000000, -- 背景颜色（纯黑）
    alpha = 200,      -- 透明度（0-255）
    fontSize = 15,    -- 字体大小
    textColor = 0xFFFFFF, -- 文字颜色（白色）
    borderColor = 0xFFFFFF, -- 边框颜色（白色）
    animationSpeed = 10, -- 动画速度（值越小越快）
    checkInterval = 100, -- 检测间隔(ms)
    displayDuration = 300 -- 显示持续时间(ms)
}

-- 需要检测的功能列表
local featureList = {
    "无限距离",
    "秒吃",
    "穿墙",
    "飞天过检",
    "无冷却",
    "现代枪械无后座",
    "房主取物",
    "按键显示",
    "连点",
 }


-- 全局变量
local titleForm, Circle, updateTimer, checkTimer
local tick = 0
local open = false
local animt = 0
local currentFeature = nil
local featureDisplayTime = 0
local lastFeatureStates = {}

-- 初始化功能状态记录
local function InitializeFeatureStates()
    for _, featureDesc in ipairs(featureList) do
        local record = getAddressList().getMemoryRecordByDescription(featureDesc)
        if record then
            lastFeatureStates[featureDesc] = record.Active
        end
    end
end

-- 检测功能状态变化
local function CheckFeatureStatus()
    local changes = {}

    for _, featureDesc in ipairs(featureList) do
        local record = getAddressList().getMemoryRecordByDescription(featureDesc)
        if record then
            local currentState = record.Active
            local lastState = lastFeatureStates[featureDesc]

            -- 检测状态变化
            if lastState ~= nil and currentState ~= lastState then
                changes[featureDesc] = currentState
            end

            -- 更新最后状态记录
            lastFeatureStates[featureDesc] = currentState
        end
    end

    return changes
end

-- 更新显示内容
local function UpdateDisplay()
    if not titleForm or titleForm.destroyed then return end

    -- 显示功能状态或时间
    if featureDisplayTime &gt; 0 and currentFeature then
        Circle.Caption = currentFeature
    else
        local timeStr = os.date("%H:%M:%S")
        Circle.Caption = string.format(" Autumn丨Time : %s", timeStr)
    end

    if open then
    local targetWidth = (featureDisplayTime &gt; 0 and currentFeature) and
                       (string.len(currentFeature) * config.fontSize * 0.6 + 40) or
                       config.width
    local targetLeft = (titleForm.Width - targetWidth) / 2

    Circle.Width = Circle.Width + (targetWidth - Circle.Width) / config.animationSpeed
    Circle.Left = Circle.Left + (targetLeft - Circle.Left) / config.animationSpeed

        animt = animt + 1
    else
        -- 关闭动画
        Circle.Width = Circle.Width + (0 - Circle.Width) / config.animationSpeed
        Circle.Left = Circle.Left + (titleForm.Width/2 - Circle.Left) / config.animationSpeed
        animt = animt + 1
        if animt &gt;= 1999 then
            titleForm.destroy()
        end
    end
end

-- 主定时器函数
local function OnUpdateTimer()
    tick = tick + 5

    -- 更新显示时间
    if featureDisplayTime &gt; 0 then
        featureDisplayTime = featureDisplayTime - 5
        if featureDisplayTime &lt;= 0 then
            currentFeature = nil
        end
    end

    UpdateDisplay()
end

-- 检测定时器函数
local function OnCheckTimer()
    local changes = CheckFeatureStatus()

    for featureDesc, state in pairs(changes) do
        currentFeature = string.format(" %s已%s", featureDesc, state and "开启" or "关闭")
        featureDisplayTime = config.displayDuration

        -- 立即更新显示
        UpdateDisplay()
    end
end

-- 创建窗体和控制元素
local function CreateForm()
    -- 创建窗体
    titleForm = createForm(false)
    titleForm.BorderStyle = 'bsNone'
    titleForm.FormStyle = 'fsSystemStayOnTop'
    titleForm.Width = config.width
    titleForm.Height = config.height
    titleForm.Top = config.y
    titleForm.Left = config.x == 0 and (getScreenWidth() - config.width) // 2 or config.x

    -- 创建圆形按钮
    Circle = createCECustomButton(titleForm)
    Circle.Parent = titleForm
    Circle.Left = titleForm.Width/2
    Circle.Top = 0
    Circle.Width = 0
    Circle.Height = titleForm.Height
    Circle.Caption = ''
    Circle.RoudingX = 200
    Circle.RoudingY = 200
    Circle.ButtonColor = config.bgColor
    Circle.DrawFocusRect = false
    Circle.BorderSize = 1
    Circle.BorderColor = config.borderColor
    Circle.ButtonDownColor = Circle.ButtonColor
    Circle.ButtonHighlightedColor = Circle.ButtonColor
    Circle.FocusElipseColor = Circle.ButtonColor
    Circle.Font.Style = 'fsBold'
    Circle.Font.Size = config.fontSize
    Circle.Font.Color = config.textColor

    -- 设置透明背景
    titleForm.Color = 0xFF00FF
    titleForm.setLayeredAttributes(0xFF00FF, config.alpha, 0x01)

    -- 确保窗口始终置顶
    titleForm.onShow = function()
        titleForm.BringToFront()
    end
end

-- 清理资源
local function Cleanup()
    if checkTimer then
        checkTimer.destroy()
        checkTimer = nil
    end

    if updateTimer then
        updateTimer.destroy()
        updateTimer = nil
    end

    if titleForm and not titleForm.destroyed then
        titleForm.destroy()
        titleForm = nil
    end
end

[ENABLE]
do
    -- 初始化
    CreateForm()
    InitializeFeatureStates()

    -- 创建定时器
    updateTimer = createTimer()
    updateTimer.Interval = 1
    updateTimer.onTimer = OnUpdateTimer

    checkTimer = createTimer()
    checkTimer.Interval = config.checkInterval
    checkTimer.onTimer = OnCheckTimer

    open = true
    titleForm.visible = true
end

[DISABLE]
do
    animt = 0
    open = false
    currentFeature = nil
    lastFeatureStates = {}
    Cleanup()
end
</AssemblerScript>
