              <AssemblerScript>{$Lua}
if syntaxcheck then return end

[ENABLE]
-- 定义右键连点线程变量（避免重复创建）
if not RightsuperLuaAutoClickForTriggerbot_thread then
  RightsuperLuaAutoClickForTriggerbot_thread = createNativeThread(function (thread)
    thread.freeOnTerminate(false)
    thread.Name = 'RightsuperLuaAutoClickForTriggerbot_thread'
    while not thread.Terminated do
          -- 替换为右键按下/抬起事件
          mouse_event(MOUSEEVENTF_RIGHTDOWN)
          mouse_event(MOUSEEVENTF_RIGHTUP)
          sleep(10) -- 连点间隔10毫秒，可根据需要调整
    end
  end)
end

[DISABLE]
if RightsuperLuaAutoClickForTriggerbot_thread then -- 终止并清理线程
   RightsuperLuaAutoClickForTriggerbot_thread.terminate()
   RightsuperLuaAutoClickForTriggerbot_thread.waitfor()
   RightsuperLuaAutoClickForTriggerbot_thread.destroy()
   RightsuperLuaAutoClickForTriggerbot_thread=nil
end
