          <AssemblerScript>{$lua}
function RGB(time,tick)
return math.floor(math.sin(time + tick) * 127.5 + 128) * 0x10000 + math.floor(math.sin(time + 2 + tick) * 127.5 + 128) * 0x100 + math.floor(math.sin(time + 4 + tick) * 127.5 + 128)
end
function create(id,x,y)
button[id] = createPanel(key)
button[id].Top = y
button[id].Left = x
button[id].Color = 0x010101
button[id].Width = 50
button[id].Height = 50
button[id].Caption = id
button[id].BevelWidth = 3
button[id].Font.Color = 0xffffff
button[id].Font.Name = 'Comic Sans MS'
button[id].Font.Size = 15
button[id].Font.Style = 'fsStayOnTop'
button[id].Font.Pitch = 'fsFixed'
button[id].Font.Quality = 'fqCleartypeNatural'
end
[ENABLE]
button = {}

key = createForm(false)
key.Color = 0x000000
key.Width = getScreenWidth()
key.Height = getScreenHeight()
key.FormStyle = 'fsSystemStayOnTop'
key.BorderStyle = 'bsNone'
key.setLayeredAttributes(0,175,LWA_ALPHA|LWA_COLORKEY)
key.visible = true
create('A',125,650)
create('S',175,650)
create('D',225,650)
create('W',175,600)
button['space'] = createPanel(key)
button['space'].Top = 700
button['space'].Left = 125
button['space'].Color = 0x010101
button['space'].Width = 150
button['space'].Height = 50
button['space'].Caption = '━━━━━━━━━━━━'
button['space'].BevelWidth = 3
button['space'].Font.Color = 0xffffff
button['space'].Font.Size = 10
button['space'].Font.Pitch = 'fsFixed'
button['space'].Font.Quality = 'fqCleartypeNatural'
button['cps'] = createPanel(key)
button['cps'].Top = 750
button['cps'].Left = 125
button['cps'].Color = 0x010101
button['cps'].Width = 150
button['cps'].Height = 50
button['cps'].Caption = 'Mouse'
button['cps'].BevelWidth = 3
button['cps'].Font.Color = 0xffffff
button['cps'].Font.Size = 15
button['cps'].Font.Name = 'Comic Sans MS'
button['cps'].Font.Style = 'fsBold'
button['cps'].Font.Pitch = 'fsFixed'
button['cps'].Font.Quality = 'fqCleartypeNatural'

time = 0
tt = 0
click = 0
time2 = 0
onclick = false
t = createTimer(key)
t.Interval = 1
t.onTimer = function()
time = time + 0.05
tt = tt + 1
button['W'].BevelColor = RGB(time,0)
button['A'].BevelColor = RGB(time,50)
button['S'].BevelColor = RGB(time,100)
button['D'].BevelColor = RGB(time,150)
button['space'].BevelColor = RGB(time,200)
button['cps'].BevelColor = RGB(time,250)

if isKeyPressed(0x01) and not onclick then
onclick = true
click = click + 1
else if not isKeyPressed(0x01) then
onclick = false
end
end
ttt = tt / 100
cps = click / ttt
cps = math.floor(cps * 10) / 10
button['cps'].Caption = 'Mouse'

if isKeyPressed(VK_SPACE) then
button['space'].color = 0xffffff
button['space'].Font.Color = 0x010101
else
button['space'].color = 0x010101
button['space'].Font.Color = 0xffffff
end
if isKeyPressed(VK_W) then
button['W'].color = 0xffffff
button['W'].Font.Color = 0x010101
else
button['W'].color = 0x010101
button['W'].Font.Color = 0xffffff
end

if isKeyPressed(VK_A) then
button['A'].color = 0xffffff
button['A'].Font.Color = 0x010101
else
button['A'].color = 0x010101
button['A'].Font.Color = 0xffffff
end

if isKeyPressed(VK_S) then
button['S'].color = 0xffffff
button['S'].Font.Color = 0x010101
else
button['S'].color = 0x010101
button['S'].Font.Color = 0xffffff
end

if isKeyPressed(VK_D) then
button['D'].color = 0xffffff
button['D'].Font.Color = 0x010101
else
button['D'].color = 0x010101
button['D'].Font.Color = 0xffffff
end

if isKeyPressed(1) then
button['cps'].color = 0xffffff
button['cps'].Font.Color = 0x010101
else
button['cps'].color = 0x010101
button['cps'].Font.Color = 0xffffff
end

end
[DISABLE]
onclick = nil
time = nil
click = nil
tt = nil
button = nil
t.Enabled = false
t.destroy()
key.destroy()
form.destroy()
